[
    {
        "name" : "Top 5 frequently occurring comments",
        "pipeline" : [
            { $group: { _id: "$content", total: { $sum: 1 } } },
            { $sort: { total: -1 } },
            { $limit: 5 }
        ]
    },
    {
        "name" : "All entries where the “content” field is less than 5 characters long",
        "pipeline" : [
            { $addFields: { contentLength: { $strLenCP: "$content" } } },
            { $match: { contentLength: { $lt: 5  } } },
            { $project: { contentLength: 0 } } 
        ]
    },
    {
        "name" : "Average rating for each day (the result should be in timestamp type).",
        "pipeline" : [
            { $addFields: { date_object: { $dateFromString: { dateString: "$at", format: "%Y-%m-%d %H:%M:%S" } } } },
            { $group: {_id: { $dateTrunc: { date: "$date_object", unit: "day" } }, averageRating: { $avg: "$score" } } },
            { $project: { id: 0, date_timestamp_query_result: { $toLong: "$_id" }, averageScore: 1 } }
        ]
    }
]